# Copy this to .dev.vars and fill in your values
# These are used by wrangler for local development

NUXT_KEY=your-session-key
NUXT_GOOGLE_ADS_CUSTOMER_ID=
NUXT_GOOGLE_ADS_API_TOKEN=
NUXT_GOOGLE_ADS_CLIENT_ID=
NUXT_GOOGLE_ADS_CLIENT_SECRET=
NUXT_GOOGLE_ADS_REFRESH_TOKEN=
NUXT_POSTMARK_API_KEY=
# Partner credentials issued by gscdump.com (POST /api/admin/partners/setup).
# The webhook secret is what gscdump HMAC-signs deliveries with; without it the
# receiver at /api/webhooks/gscdump fails closed.
NUXT_GSCDUMP_API_KEY=
NUXT_GSCDUMP_WEBHOOK_SECRET=
# Point site registrations at a tunnel in dev so webhooks are testable end to
# end; unset, every registration tells gscdump to call production.
NUXT_GSCDUMP_WEBHOOK_URL=
# Point at a local gscdump.com instance. Must be the `/api` root, not `/api/partner`.
NUXT_GSCDUMP_API_URL=
